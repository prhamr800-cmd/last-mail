<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.github.florent37.expansionpanel.ExpansionHeader
        android:id="@+id/sampleHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:expansion_headerIndicator="@+id/headerIndicator"
        app:expansion_layout="@+id/expansionLayout"
        app:expansion_toggleOnClick="true">
        <RelativeLayout
            android:background="@android:color/white"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <TextView
                android:textColor="#aaa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/see_more_info"
                android:layout_centerInParent="true"
                android:layout_centerVertical="true"/>
            <android.support.v7.widget.AppCompatImageView
                android:id="@+id/headerIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:adjustViewBounds="true"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                app:srcCompat="@drawable/ic_expansion_header_indicator_grey_24dp"/>
        </RelativeLayout>
    </com.github.florent37.expansionpanel.ExpansionHeader>
    <com.github.florent37.expansionpanel.ExpansionLayout
        android:id="@+id/expansionLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:expansion_expanded="false">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <com.digikala.dms.view.custom.XeiTextView
                        android:textColor="@color/shipment_detail_header_color"
                        android:gravity="center"
                        android:background="@color/grey_100"
                        android:padding="@dimen/item_padding"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/item_size_header"
                        android:text="@string/customer_name"/>
                    <com.digikala.dms.view.custom.XeiTextView
                        android:textColor="@color/shipment_detail_content_color"
                        android:gravity="center"
                        android:padding="@dimen/item_padding"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/item_size_header"
                        android:text="@string/phone"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <com.digikala.dms.view.custom.XeiTextView
                        android:textColor="@color/shipment_detail_header_color"
                        android:gravity="center"
                        android:id="@+id/customer_name_text_view"
                        android:background="@color/grey_200"
                        android:padding="@dimen/item_padding"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/item_size_header"/>
                    <com.digikala.dms.view.custom.XeiTextView
                        android:textColor="@color/shipment_detail_content_color"
                        android:gravity="center"
                        android:id="@+id/customer_phone_text_view"
                        android:background="@color/background_white"
                        android:padding="@dimen/item_padding"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/item_size_header"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <com.digikala.dms.view.custom.XeiTextView
                        android:textColor="@color/shipment_detail_header_color"
                        android:gravity="center"
                        android:background="@color/grey_100"
                        android:padding="@dimen/item_padding"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/item_size_header"
                        android:text="@string/delivery_date"/>
                    <com.digikala.dms.view.custom.XeiTextView
                        android:textColor="@color/shipment_detail_content_color"
                        android:gravity="center"
                        android:padding="@dimen/item_padding"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/item_size_header"
                        android:text="@string/delivery_time"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <com.digikala.dms.view.custom.XeiTextView
                        android:textColor="@color/shipment_detail_header_color"
                        android:gravity="center"
                        android:id="@+id/delivery_date_text_view"
                        android:background="@color/grey_200"
                        android:padding="@dimen/item_padding"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/item_size_header"/>
                    <com.digikala.dms.view.custom.XeiTextView
                        android:textColor="@color/shipment_detail_content_color"
                        android:gravity="center"
                        android:id="@+id/delivery_time_text_view"
                        android:background="@color/background_white"
                        android:padding="@dimen/item_padding"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/item_size_header"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <com.digikala.dms.view.custom.XeiTextView
                        android:textColor="@color/shipment_detail_header_color"
                        android:gravity="center"
                        android:background="@color/grey_100"
                        android:padding="@dimen/item_padding"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/item_size_header"
                        android:text="@string/payment_state"/>
                    <com.digikala.dms.view.custom.XeiTextView
                        android:textColor="@color/shipment_detail_content_color"
                        android:gravity="center"
                        android:padding="@dimen/item_padding"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/item_size_header"
                        android:text="@string/payment_payable"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <com.digikala.dms.view.custom.XeiTextView
                        android:textColor="@color/shipment_detail_header_color"
                        android:gravity="center"
                        android:id="@+id/payment_state_text_view"
                        android:background="@color/grey_200"
                        android:padding="@dimen/item_padding"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/item_size_header"/>
                    <com.digikala.dms.view.custom.XeiTextView
                        android:textSize="18sp"
                        android:textColor="@color/shipment_detail_payable_color"
                        android:gravity="center"
                        android:id="@+id/payment_price_text_view"
                        android:background="@color/background_white"
                        android:padding="@dimen/item_padding"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/item_size_header"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <com.digikala.dms.view.custom.XeiTextView
                        android:textColor="@color/shipment_detail_header_color"
                        android:gravity="center"
                        android:background="@color/grey_100"
                        android:padding="@dimen/item_padding"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/item_size_header"
                        android:text="@string/tracking_id"/>
                    <com.digikala.dms.view.custom.XeiTextView
                        android:textColor="@color/shipment_detail_content_color"
                        android:gravity="center"
                        android:padding="@dimen/item_padding"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/item_size_header"
                        android:text="@string/invoice_id"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <com.digikala.dms.view.custom.XeiTextView
                        android:textColor="@color/shipment_detail_header_color"
                        android:gravity="center"
                        android:id="@+id/tracking_id_text_view"
                        android:background="@color/grey_200"
                        android:padding="@dimen/item_padding"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/item_size_header"/>
                    <com.digikala.dms.view.custom.XeiTextView
                        android:textColor="@color/shipment_detail_content_color"
                        android:gravity="center"
                        android:id="@+id/invoice_id_text_view"
                        android:background="@color/background_white"
                        android:padding="@dimen/item_padding"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/item_size_header"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.github.florent37.expansionpanel.ExpansionLayout>
</LinearLayout>
