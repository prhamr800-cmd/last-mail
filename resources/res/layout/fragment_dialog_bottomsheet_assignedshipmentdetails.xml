<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/assignedShipments_bottomSheet_background"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="android.support.design.widget.BottomSheetBehavior">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <android.support.v7.widget.CardView
            android:id="@+id/fragmentDialogBottomsheetAssignShipmentDetails_cardView_postalAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardPreventCornerOverlap="true"
            app:cardUseCompatPadding="true">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.digikala.dms.view.custom.XeiTextView
                    android:textColor="@color/shipment_detail_header_color"
                    android:gravity="center"
                    android:background="@color/grey_100"
                    android:padding="@dimen/item_padding"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/item_size_header"
                    android:text="@string/assignedShipments_bottomSheet_recipientPostalAddress"
                    app:locale="auto"/>
                <com.digikala.dms.view.custom.XeiTextView
                    android:textColor="@color/shipment_detail_content_color"
                    android:gravity="center"
                    android:id="@+id/delivery_address_text_view"
                    android:padding="@dimen/item_padding"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/item_size"
                    android:drawableRight="@drawable/ic_location"
                    app:locale="auto"/>
            </LinearLayout>
        </android.support.v7.widget.CardView>
        <android.support.v7.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardPreventCornerOverlap="true"
            app:cardUseCompatPadding="true">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/rw_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@color/grey_100"
                    android:padding="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/item_size_header"
                    android:layout_marginBottom="8dp"
                    android:weightSum="11">
                    <com.digikala.dms.view.custom.XeiTextView
                        android:textColor="@color/shipment_detail_header_color"
                        android:gravity="center"
                        android:id="@+id/rw_code"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="کد کالا"
                        android:layout_weight="2"
                        app:locale="auto"/>
                    <com.digikala.dms.view.custom.XeiTextView
                        android:textColor="@color/shipment_detail_header_color"
                        android:gravity="center"
                        android:id="@+id/rw_desc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="شرح کالا"
                        android:layout_weight="8"
                        app:locale="auto"/>
                    <com.digikala.dms.view.custom.XeiTextView
                        android:textColor="@color/shipment_detail_header_color"
                        android:gravity="center"
                        android:id="@+id/rw_count"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="تعداد"
                        android:layout_weight="1"
                        app:locale="auto"/>
                </LinearLayout>
            </LinearLayout>
        </android.support.v7.widget.CardView>
    </LinearLayout>
</android.support.v4.widget.NestedScrollView>
