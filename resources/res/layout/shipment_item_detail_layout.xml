<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/rw_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/grey_100"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:weightSum="11">
        <com.digikala.dms.view.custom.XeiTextView
            android:textColor="@color/shipment_detail_header_color"
            android:gravity="center"
            android:id="@+id/rw_code"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="کد کالا"
            android:layout_weight="2"
            app:locale="auto"/>
        <com.digikala.dms.view.custom.XeiTextView
            android:textColor="@color/shipment_detail_header_color"
            android:gravity="center"
            android:id="@+id/rw_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="شرح کالا"
            android:lines="2"
            android:layout_weight="4"
            app:locale="auto"/>
        <com.digikala.dms.view.custom.XeiTextView
            android:textColor="@color/shipment_detail_header_color"
            android:gravity="center"
            android:id="@+id/rw_price"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="قیمت واحد"
            android:layout_weight="4"
            app:locale="auto"/>
        <com.digikala.dms.view.custom.XeiTextView
            android:textColor="@color/shipment_detail_header_color"
            android:gravity="center"
            android:id="@+id/rw_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="تعداد"
            android:layout_weight="1"
            app:locale="auto"/>
    </LinearLayout>
</LinearLayout>
