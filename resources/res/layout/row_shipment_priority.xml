<?xml version="1.0" encoding="utf-8"?>
<android.support.v7.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/activity_vertical_margin"
    android:foreground="?android:attr/selectableItemBackground"
    android:minHeight="80dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    app:cardCornerRadius="@dimen/activity_horizontal_margin"
    app:cardElevation="@dimen/activity_horizontal_margin">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="10">
        <com.digikala.dms.view.custom.XeiTextView
            android:textSize="@dimen/main_row_shipments_textSize_itemNo"
            android:textStyle="bold"
            android:textColor="@color/main_row_shipments_textColor_itemNo"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/rowRecyclerviewShipmentsPriority_xeiTextView_itemNo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:locale="auto"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="6">
            <com.digikala.dms.view.custom.XeiTextView
                android:textSize="@dimen/text_size_small"
                android:textColor="@color/main_row_shipments_textColor_postalAddress"
                android:id="@+id/shipment_priority_row_address"
                android:padding="@dimen/padding_vertical_titlesLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/assignedShipments_screenTitle"
                android:layout_toRightOf="@+id/thumbnail"
                android:layout_alignTop="@+id/thumbnail"
                app:locale="auto"/>
            <com.digikala.dms.view.custom.XeiTextView
                android:textSize="12sp"
                android:textColor="@color/partial_disable"
                android:ellipsize="end"
                android:id="@+id/shipment_priority_row_time"
                android:padding="@dimen/padding_vertical_titlesLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="shipmentTime"
                android:drawablePadding="@dimen/main_row_shipments_padding_compoundDrawable_postalAddress"
                android:layout_toRightOf="@+id/thumbnail"
                android:layout_below="@+id/shipment_priority_row_address"
                android:drawableStart="@drawable/ic_alarm_clock"
                app:locale="auto"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/shipment_priority_row_touch_icon"
            android:padding="@dimen/item_padding"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_swipe_black_24dp"
            android:layout_weight="3"
            style="bold"/>
    </LinearLayout>
</android.support.v7.widget.CardView>
