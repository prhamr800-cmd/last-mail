<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:background="@drawable/ic_location_off"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.digikala.dms.view.custom.XeiTextView
            android:textSize="@dimen/text_size_large"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="مکان‌یاب غیر فعال است"/>
        <com.digikala.dms.view.custom.XeiTextView
            android:textSize="12dp"
            android:textColor="@color/grey_800"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="لطفا مکان‌یاب گوشی خود را روشن کنید"/>
        <Button
            android:textSize="13sp"
            android:textColor="@color/white"
            android:id="@+id/button_turn_on"
            android:background="@color/colorAccent"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginTop="16dp"
            android:text="روشن کردن مکان‌یاب "
            android:paddingStart="22dp"
            android:paddingEnd="22dp"/>
    </LinearLayout>
</FrameLayout>
