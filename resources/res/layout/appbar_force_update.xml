<?xml version="1.0" encoding="utf-8"?>
<android.support.design.widget.AppBarLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/AppTheme.AppBarOverlay"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mainScreen_toolbar_height"
        android:paddingStart="@dimen/mainScreen_toolbar_paddingStart"
        app:layout_scrollFlags="snap|scroll">
        <com.digikala.dms.view.custom.XeiTextView
            android:textSize="@dimen/textSize_deliveryName"
            android:textColor="@color/text_white"
            android:gravity="start"
            android:id="@+id/appbarMain_xeiTextView_deliveryId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_deliveryId"
            app:locale="auto"/> ​ 
    </RelativeLayout>
</android.support.design.widget.AppBarLayout>
