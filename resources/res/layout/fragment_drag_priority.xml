<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/activity_shipment_priority_root"
    android:background="#eeeeee"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <android.support.v7.widget.RecyclerView
        android:id="@+id/activity_shipment_priority_rv"
        android:paddingBottom="50dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="520dp"/>
    <ViewStub
        android:layout_gravity="center"
        android:id="@+id/activity_shipment_priority_error_stub"
        android:layout="@layout/error_view_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize">
        <com.pnikosis.materialishprogress.ProgressWheel
            android:id="@+id/activity_priorityShipment_progressWheel_loading"
            android:visibility="gone"
            android:layout_width="@dimen/assignedShipments_diameter_progressWheel"
            android:layout_height="@dimen/assignedShipments_diameter_progressWheel"
            android:layout_centerInParent="true"
            app:matProg_barColor="@color/colorAccent"
            app:matProg_progressIndeterminate="true"/>
    </RelativeLayout>
</RelativeLayout>
