<?xml version="1.0" encoding="utf-8"?>
<android.support.design.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/grey_400"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">
    <LinearLayout
        android:gravity=""
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <android.support.v7.widget.Toolbar
            android:background="?attr/colorPrimary"
            android:padding="0dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:contentInsetEnd="0dp"
            app:contentInsetStart="0dp"
            app:popupTheme="@style/AppTheme.PopupOverlay">
            <RelativeLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageButton
                    android:id="@+id/fragment_signature_back"
                    android:background="@drawable/hover_oval"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:src="@drawable/ic_arrow_back_white_24dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"/>
                <com.digikala.dms.view.custom.XeiTextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#fff"
                    android:gravity="start|center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="امضای مشتری"
                    android:layout_alignParentTop="true"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/fragment_signature_back"
                    app:locale="auto"/>
            </RelativeLayout>
        </android.support.v7.widget.Toolbar>
        <RelativeLayout
            android:background="@color/colorPrimary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_tabLayout">
            <ImageButton
                android:id="@+id/clearBtn"
                android:background="@drawable/hover_oval"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_delete_white_24dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
            <com.digikala.dms.view.custom.XeiTextView
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:text="@string/signature"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <com.digikala.dms.view.custom.PaintingView
            android:layout_gravity="center"
            android:id="@+id/paintingView"
            android:layout_width="match_parent"
            android:layout_height="300dp"/>
    </LinearLayout>
    <RelativeLayout
        android:gravity="left"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr">
        <com.github.jorgecastilloprz.FABProgressCircle
            android:layout_gravity="bottom"
            android:id="@+id/fabProgressCircle_signature_confirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:arcColor="@color/fabProgressWheel">
            <android.support.design.widget.FloatingActionButton
                android:layout_gravity="bottom"
                android:id="@+id/fragmentSignature_fab"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:src="@drawable/ic_checkmark_white"/>
        </com.github.jorgecastilloprz.FABProgressCircle>
    </RelativeLayout>
</android.support.design.widget.CoordinatorLayout>
