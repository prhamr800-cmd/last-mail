<?xml version="1.0" encoding="utf-8"?>
<android.support.v7.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    card_view:cardBackgroundColor="@color/background_white"
    card_view:cardCornerRadius="2dp"
    card_view:cardElevation="2dp"
    card_view:cardPreventCornerOverlap="true"
    card_view:cardUseCompatPadding="true">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/item_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/item_state_image"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_margin="8dp"
            android:src="@drawable/ic_checked"/>
        <LinearLayout
            android:orientation="vertical"
            android:padding="8dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp">
            <com.digikala.dms.view.custom.XeiTextView
                android:textSize="12sp"
                android:textColor="@color/grey_700"
                android:gravity="start|center_vertical"
                android:id="@+id/item_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.digikala.dms.view.custom.XeiTextView
                android:textSize="12sp"
                android:textColor="@color/grey_700"
                android:gravity="start|center_vertical"
                android:id="@+id/item_brand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <View
                android:id="@+id/separator"
                android:background="@color/partial_returned_separator"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="32dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"/>
            <com.digikala.dms.view.custom.XeiTextView
                android:textSize="12sp"
                android:textColor="@color/grey_600"
                android:gravity="center"
                android:id="@+id/item_reject_reason"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <com.digikala.dms.view.custom.XeiTextView
                    android:textSize="12sp"
                    android:textColor="@color/grey_600"
                    android:gravity="center"
                    android:id="@+id/item_amount_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="قیمت واحد:"/>
                <com.digikala.dms.view.custom.XeiTextView
                    android:textSize="12sp"
                    android:textColor="@color/green_500"
                    android:gravity="center"
                    android:id="@+id/item_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/item_count_layout"
            android:background="@color/grey_100"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <com.digikala.dms.view.custom.XeiTextView
                android:textSize="12sp"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/item_count"/>
            <com.digikala.dms.view.custom.XeiTextView
                android:textSize="14sp"
                android:gravity="center"
                android:id="@+id/item_count_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"/>
            <LinearLayout
                android:background="#eaeaea"
                android:layout_width="match_parent"
                android:layout_height="2dp"/>
            <com.digikala.dms.view.custom.XeiTextView
                android:textSize="12sp"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/item_return_count"/>
            <com.digikala.dms.view.custom.XeiTextView
                android:textSize="14sp"
                android:gravity="center"
                android:id="@+id/item_return_count_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"/>
        </LinearLayout>
    </LinearLayout>
</android.support.v7.widget.CardView>
